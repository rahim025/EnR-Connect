rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail()     { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && (exists(/databases/$(db)/documents/admins/$(mail())) || exists(/databases/$(db)/documents/createurs/$(mail()))); }
    function isMember() { return signedIn() && (isAdmin() || exists(/databases/$(db)/documents/allowed/$(mail()))); }

    // Chaque utilisateur peut seulement vérifier sa propre ligne
    match /admins/{e}    { allow get: if signedIn() && mail() == e; }
    match /createurs/{e} { allow get: if signedIn() && mail() == e; }
    match /allowed/{e} {
      allow get:    if signedIn() && (mail() == e || isAdmin());
      allow list:   if isAdmin();
      allow write:  if isAdmin();
    }

    match /messages/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && (!('text' in request.resource.data) || request.resource.data.text.size() <= 2000)
                    && (request.resource.data.kind != 'announce' || isAdmin());
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }

    match /media/{id} {
      allow get:    if isMember();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }

    match /dossiers/{id} {
      allow read:   if isMember();
      allow create: if isAdmin() && request.resource.data.nom is string && request.resource.data.nom.size() <= 40;
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read:   if isMember();
      allow create, update: if isMember() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
  }
}
